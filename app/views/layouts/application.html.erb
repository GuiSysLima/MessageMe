<!DOCTYPE html>
<html>
  <head>
    <title>MessageMe</title>
    <%= favicon_link_tag %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= action_cable_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body>
    <div class="ui small inverted menu">
      <div class="ui container">
        <%= render 'layouts/navigation' %>
      </div>
    </div>

  <div class="ui container">
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </div>
  <script>
    (function() {
      var connectTurboToCable = function() {
        
        if (typeof ActionCable === 'undefined') return;
        
        if (!window.App) window.App = {};
    
        if (!window.App.cable) {
          console.log("🚀 [1/3] Criando Action Cable...");
          window.App.cable = ActionCable.createConsumer();
        }

        if (typeof Turbo !== 'undefined') {
          if (Turbo.connectStreamSource) {
            console.log("🚀 [2/3] Conectando Turbo (connectStreamSource)...");
            Turbo.connectStreamSource(window.App.cable);
          } 
          else if (Turbo.session && Turbo.session.connectStreamSource) {
            console.log("🚀 [2/3] Conectando Turbo (Turbo.session)...");
            Turbo.session.connectStreamSource(window.App.cable);
          }
          else {
            console.warn("⚠️ Turbo detectado, mas método de conexão não encontrado.");
          }
        }
      };
      
      connectTurboToCable();
      document.addEventListener("turbo:load", connectTurboToCable);
      document.addEventListener("DOMContentLoaded", connectTurboToCable);
    })();
  </script>
  </body>
</html>
