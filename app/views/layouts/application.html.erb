<!DOCTYPE html>
<html>
  <head>
    <title>MessageMe</title>
    <%= favicon_link_tag %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= action_cable_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>
  <body>
    <div class="ui small inverted menu">
      <div class="ui container">
        <%= render 'layouts/navigation' %>
      </div>
    </div>

  <div class="ui container">
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </div>
  <script>
    (function() {
      var startCable = function() {
        // Verifica se as bibliotecas carregaram
        if (typeof ActionCable !== 'undefined' && typeof Turbo !== 'undefined') {
          
          if (!window.App) window.App = {};
          
          // 1. Cria o consumidor se não existir
          if (!window.App.cable) {
            console.log("🚀 (1/2) Criando Action Cable Consumer...");
            window.App.cable = ActionCable.createConsumer();
          }

          // 2. O PULO DO GATO: Conecta o Turbo ao Action Cable
          if (Turbo.connectStreamSource) {
            console.log("🚀 (2/2) Conectando Turbo ao Stream...");
            Turbo.connectStreamSource(window.App.cable);
          } else {
            // Fallback para versões mais antigas do Turbo
            console.log("🚀 (2/2) Turbo detectado (Modo Legacy)...");
            // Força uma assinatura "falsa" só para abrir o WebSocket e manter a porta aberta
            window.App.cable.subscriptions.create("ActionCable::Channel");
          }
        }
      };

      // Tenta rodar imediatamente e também nos eventos de carregamento
      startCable();
      document.addEventListener("turbo:load", startCable);
      document.addEventListener("DOMContentLoaded", startCable);
    })();
  </script>
  </body>
</html>
